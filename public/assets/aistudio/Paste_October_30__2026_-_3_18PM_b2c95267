    <!-- JavaScript 邏輯 -->
    <script>
        // 清除先前快取，確保題目與文章為空
        localStorage.removeItem('topics');
        localStorage.removeItem('articles');

        let users = JSON.parse(localStorage.getItem('users')) || [];
        let currentUser = JSON.parse(localStorage.getItem('currentUser')) || null;
        let dailyQuote = localStorage.getItem('dailyQuote') || '';

        let topics = [];
        let submissions = JSON.parse(localStorage.getItem('submissions')) || [];
        let articles = [];

        let currentAuthMode = 'student-login';

        window.onload = function() {
            renderAuthArea();
            renderTopics();
            renderArticles();
            renderDailyQuote();
            if (currentUser) {
                applyRoleUI();
            }
        };

        function saveData() {
            localStorage.setItem('users', JSON.stringify(users));
            localStorage.setItem('currentUser', JSON.stringify(currentUser));
            localStorage.setItem('dailyQuote', dailyQuote);
            localStorage.setItem('topics', JSON.stringify(topics));
            localStorage.setItem('submissions', JSON.stringify(submissions));
            localStorage.setItem('articles', JSON.stringify(articles));
        }

        function renderDailyQuote() {
            const displayEl = document.getElementById('dailyQuoteText');
            if (dailyQuote && dailyQuote.trim() !== '') {
                displayEl.innerText = `「${dailyQuote}」`;
                displayEl.classList.remove('italic', 'text-stone-400');
            } else {
                displayEl.innerText = '今日暫無名言佳句';
                displayEl.classList.add('italic');
            }
        }

        function updateDailyQuote() {
            const val = document.getElementById('teacherDailyQuoteInput').value.trim();
            dailyQuote = val;
            saveData();
            renderDailyQuote();
            alert('每日名言佳句已更新成功！');
            switchNav('home');
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobileMenu');
            menu.classList.toggle('hidden');
        }

        function switchNav(pageId) {
            document.querySelectorAll('main > section').forEach(el => el.classList.add('hidden'));
            document.getElementById(`page-${pageId}`).classList.remove('hidden');

            document.querySelectorAll('.active-tab').forEach(el => {
                el.classList.remove('active-tab');
                el.classList.add('text-[#7c634b]');
            });
            const activeBtn = document.getElementById(`nav-${pageId}`);
            if (activeBtn) {
                activeBtn.classList.add('active-tab');
                activeBtn.classList.remove('text-[#7c634b]');
            }

            if (pageId === 'teacher') renderTeacherSubmissions();
            if (pageId === 'records') renderStudentRecords();
            if (pageId === 'students') renderStudentManagement();
            if (pageId === 'quotes') {
                document.getElementById('teacherDailyQuoteInput').value = dailyQuote;
            }
        }

        function openAuthModal(mode) {
            currentAuthMode = mode;
            const title = document.getElementById('authModalTitle');
            const btn = document.getElementById('authSubmitBtn');
            const nameField = document.getElementById('registerNameField');
            const accountLabel = document.getElementById('authAccountLabel');
            const emailInput = document.getElementById('authEmail');

            if (mode === 'student-login') {
                title.innerText = '學生登入';
                btn.innerText = '學生登入';
                accountLabel.innerText = '電子郵件 Email';
                emailInput.placeholder = 'student@example.com';
                nameField.classList.add('hidden');
            } else if (mode === 'student-register') {
                title.innerText = '註冊學生帳號';
                btn.innerText = '完成註冊並登入';
                accountLabel.innerText = '電子郵件 Email';
                emailInput.placeholder = 'student@example.com';
                nameField.classList.remove('hidden');
            } else if (mode === 'teacher-login') {
                title.innerText = '教師管理後台登入';
                btn.innerText = '進入管理後台';
                accountLabel.innerText = '教師管理帳號';
                emailInput.placeholder = '請輸入帳號 (wen)';
                nameField.classList.add('hidden');
            }

            document.getElementById('authModal').classList.remove('hidden');
        }

        function closeAuthModal() {
            document.getElementById('authModal').classList.add('hidden');
        }

        function handleAuthSubmit(e) {
            e.preventDefault();
            const emailOrAcc = document.getElementById('authEmail').value.trim();
            const password = document.getElementById('authPassword').value.trim();

            if (currentAuthMode === 'teacher-login') {
                if (emailOrAcc === 'wen' && password === '25336478') {
                    currentUser = { id: 'teacher_wen', name: 'wen 老師', role: 'teacher', email: 'wen@academy.edu' };
                    saveData();
                    renderAuthArea();
                    applyRoleUI();
                    closeAuthModal();
                    switchNav('teacher');
                    alert('尊貴的 wen 老師，歡迎登入管理後台！');
                } else {
                    alert('教師帳號或密碼不正確！');
                }
            } else if (currentAuthMode === 'student-login') {
                const user = users.find(u => u.email === emailOrAcc && u.password === password && u.role === 'student');
                if (user) {
                    currentUser = user;
                    saveData();
                    renderAuthArea();
                    applyRoleUI();
                    closeAuthModal();
                    alert(`歡迎回來，${user.name} 同學！`);
                } else {
                    alert('學生 Email 或密碼不正確！');
                }
            } else if (currentAuthMode === 'student-register') {
                if (users.some(u => u.email === emailOrAcc)) {
                    alert('該 Email 已被註冊！');
                    return;
                }
                const name = document.getElementById('authName').value.trim();

                const newUser = { id: 'u_' + Date.now(), name, email: emailOrAcc, password, role: 'student' };
                users.push(newUser);
                currentUser = newUser;
                saveData();
                renderAuthArea();
                applyRoleUI();
                closeAuthModal();
                alert(`帳號註冊成功！歡迎使用平台，${name}。`);
            }
        }

        function logout() {
            currentUser = null;
            saveData();
            renderAuthArea();
            applyRoleUI();
            switchNav('home');
            alert('已安全登出！');
        }

        function renderAuthArea() {
            const container = document.getElementById('authArea');
            if (currentUser) {
                const isTeacher = currentUser.role === 'teacher';
                container.innerHTML = `
                    <div class="flex items-center space-x-2 sm:space-x-3">
                        <div class="text-right hidden sm:block">
                            <p class="text-xs sm:text-sm font-black text-[#4a2e1b]">${currentUser.name}</p>
                            <p class="text-[10px] sm:text-xs ${isTeacher ? 'text-[#8c2e1b] font-bold' : 'text-[#2d5a3f] font-bold'}">${isTeacher ? '專任教師' : '學生帳號'}</p>
                        </div>
                        <button onclick="logout()" class="text-xs bg-[#e4d7be] hover:bg-[#d8c7a7] text-[#4a2e1b] px-2.5 sm:px-3 py-1.5 sm:py-2 rounded-lg font-bold border border-[#b8a686]">登出</button>
                    </div>
                `;
            } else {
                container.innerHTML = `
                    <button onclick="openAuthModal('student-login')" class="ancient-btn-primary text-xs px-3 sm:px-4 py-2 sm:py-2.5 rounded-xl font-bold shadow transition">學生登入</button>
                `;
            }
        }

        function applyRoleUI() {
            const guestBanner = document.getElementById('guestBanner');
            const studentElems = document.querySelectorAll('.student-only');
            const teacherElems = document.querySelectorAll('.teacher-only');

            if (!currentUser) {
                guestBanner.classList.remove('hidden');
                studentElems.forEach(el => el.classList.add('hidden'));
                teacherElems.forEach(el => el.classList.add('hidden'));
                return;
            }

            guestBanner.classList.add('hidden');
            if (currentUser.role === 'student') {
                studentElems.forEach(el => el.classList.remove('hidden'));
                teacherElems.forEach(el => el.classList.add('hidden'));
            } else {
                studentElems.forEach(el => el.classList.add('hidden'));
                teacherElems.forEach(el => el.classList.remove('hidden'));
            }
        }

        function renderTopics() {
            const weekly = topics.find(t => t.isWeekly) || topics[0];
            if (weekly) {
                document.getElementById('homeTopicTitle').innerText = weekly.title;
                document.getElementById('homeTopicDesc').innerText = weekly.desc;
                document.getElementById('homeTopicDueDate').innerText = weekly.dueDate;
            } else {
                document.getElementById('homeTopicTitle').innerText = '目前尚未發布題目';
                document.getElementById('homeTopicDesc').innerText = '老師尚未發布本週作文題目，請稍後再來查看。';
                document.getElementById('homeTopicDueDate').innerText = '--';
            }

            const listContainer = document.getElementById('homeTopicList');
            if (topics.length === 0) {
                listContainer.innerHTML = `<p class="text-xs text-[#7c634b] py-2">目前尚無發布的題目。</p>`;
            } else {
                listContainer.innerHTML = topics.map(t => `
                    <div class="p-3 bg-[#f2ebdc] rounded-xl border border-[#b8a686] flex justify-between items-center">
                        <div>
                            <p class="font-bold text-[#4a2e1b] text-xs sm:text-sm">${t.title} ${t.isWeekly ? '<span class="text-[10px] bg-[#8c2e1b] text-white font-bold px-1.5 py-0.5 rounded ml-1">每週主打</span>' : ''}</p>
                            <p class="text-[10px] sm:text-xs text-[#7c634b]">截止日期：${t.dueDate}</p>
                        </div>
                        <button onclick="goToWriteTopic('${t.id}')" class="text-xs bg-[#f7f4ed] border border-[#b8a686] hover:bg-[#e4d7be] text-[#4a2e1b] font-bold px-3 py-1.5 rounded-lg transition">寫作</button>
                    </div>
                `).join('');
            }

            const select = document.getElementById('writeTopicSelect');
            if (topics.length === 0) {
                select.innerHTML = `<option value="">尚無可選題目</option>`;
            } else {
                select.innerHTML = topics.map(t => `<option value="${t.id}">${t.title}</option>`).join('');
            }
            onWriteTopicChange();
        }

        function onWriteTopicChange() {
            const selectId = document.getElementById('writeTopicSelect').value;
            const topic = topics.find(t => t.id === selectId);
            if (topic) {
                document.getElementById('writeTopicGuide').innerText = topic.desc;
            } else {
                document.getElementById('writeTopicGuide').innerText = '目前尚未發布任何作文題目。';
            }
        }

        function startWritingCurrentTopic() {
            if (!currentUser) {
                openAuthModal('student-login');
                return;
            }
            switchNav('write');
        }

        function goToWriteTopic(topicId) {
            if (!currentUser) {
                openAuthModal('student-login');
                return;
            }
            switchNav('write');
            document.getElementById('writeTopicSelect').value = topicId;
            onWriteTopicChange();
        }

        function updateCharCount() {
            const text = document.getElementById('essayContentInput').value;
            document.getElementById('charCount').innerText = text.length;
        }

        function saveDraft() {
            alert('作文草稿已儲存至瀏覽器！');
        }

        function submitEssay() {
            if (!currentUser || currentUser.role !== 'student') {
                alert('請先以學生身份登入！');
                return;
            }
            const topicId = document.getElementById('writeTopicSelect').value;
            const topic = topics.find(t => t.id === topicId);
            if (!topic) {
                alert('請先選擇一個有效的作文題目！');
                return;
            }
            const title = document.getElementById('essayTitleInput').value.trim();
            const content = document.getElementById('essayContentInput').value.trim();

            if (!title || !content) {
                alert('請填寫完整題目與內容！');
                return;
            }

            submissions.push({
                id: 's_' + Date.now(),
                studentId: currentUser.id,
                studentName: currentUser.name,
                topicTitle: topic.title,
                essayTitle: title,
                content: content,
                date: new Date().toLocaleDateString(),
                status: 'pending',
                score: null,
                level: null,
                feedback: ''
            });

            saveData();
            document.getElementById('essayTitleInput').value = '';
            document.getElementById('essayContentInput').value = '';
            updateCharCount();
            alert('作業提交成功！已呈交 wen 老師批閱。');
            switchNav('records');
        }

        function renderStudentRecords() {
            const container = document.getElementById('studentRecordList');
            const mySubs = submissions.filter(s => s.studentId === currentUser.id);

            if (mySubs.length === 0) {
                container.innerHTML = `<p class="text-xs sm:text-sm text-[#7c634b] py-4 text-center">目前尚無作文呈交記錄。</p>`;
                return;
            }

            container.innerHTML = mySubs.map(s => `
                <div class="border border-[#b8a686] rounded-xl p-3 sm:p-4 bg-[#f2ebdc] space-y-2 sm:space-y-3">
                    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-1 sm:gap-0">
                        <div>
                            <span class="text-xs font-bold text-[#8c2e1b]">[${s.topicTitle}]</span>
                            <h4 class="font-bold text-sm sm:text-base text-[#4a2e1b]">${s.essayTitle}</h4>
                            <p class="text-[10px] sm:text-xs text-[#7c634b]">呈交日期：${s.date}</p>
                        </div>
                        <div>
                            ${s.status === 'graded' 
                                ? `<span class="bg-[#2d5a3f] text-white text-[10px] sm:text-xs font-bold px-2.5 py-1 rounded-full">已批閱: ${s.score}分 (${s.level})</span>`
                                : `<span class="bg-[#8c2e1b] text-white text-[10px] sm:text-xs font-bold px-2.5 py-1 rounded-full">待 wen 老師批閱</span>`}
                        </div>
                    </div>
                    <p class="text-xs text-[#614935] line-clamp-2">${s.content}</p>
                    ${s.status === 'graded' ? `
                        <div class="bg-[#f7f4ed] p-2.5 sm:p-3 rounded-lg border border-[#b8a686] text-xs text-[#4a2e1b]">
                            <p class="font-bold text-[#8c2e1b] mb-1">wen 老師講評：</p>
                            <p>${s.feedback || '文筆流暢，立意深遠！'}</p>
                        </div>
                    ` : ''}
                </div>
            `).join('');
        }

        function renderTeacherSubmissions() {
            const tbody = document.getElementById('teacherSubmissionTable');
            if (submissions.length === 0) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-[#7c634b] text-xs sm:text-sm">目前尚無學生呈交作文。</td></tr>`;
                return;
            }

            tbody.innerHTML = submissions.map(s => `
                <tr class="hover:bg-[#f2ebdc]">
                    <td class="p-3 font-bold text-[#4a2e1b]">${s.studentName}</td>
                    <td class="p-3">${s.topicTitle}</td>
                    <td class="p-3 text-xs text-[#7c634b]">${s.date}</td>
                    <td class="p-3">
                        ${s.status === 'graded' 
                            ? `<span class="text-[10px] sm:text-xs bg-[#2d5a3f] text-white px-2 py-0.5 rounded font-bold">已批閱</span>`
                            : `<span class="text-[10px] sm:text-xs bg-[#8c2e1b] text-white px-2 py-0.5 rounded font-bold">待批閱</span>`}
                    </td>
                    <td class="p-3 font-bold">${s.score !== null ? `${s.score}分 (${s.level})` : '--'}</td>
                    <td class="p-3 text-right">
                        <button onclick="openGradeModal('${s.id}')" class="text-xs ancient-btn-primary font-bold px-3 py-1.5 rounded-lg shadow transition">
                            ${s.status === 'graded' ? '重審批閱' : '開始批閱'}
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function openGradeModal(subId) {
            currentGradingSubId = subId;
            const sub = submissions.find(s => s.id === subId);
            if (!sub) return;

            document.getElementById('gradeModalEssayTitle').innerText = `${sub.topicTitle} - ${sub.essayTitle}`;
            document.getElementById('gradeModalAuthor').innerText = sub.studentName;
            document.getElementById('gradeModalWords').innerText = sub.content.length;
            document.getElementById('gradeModalEssayContent').innerText = sub.content;
            document.getElementById('gradeScore').value = sub.score || 90;
            document.getElementById('gradeLevel').value = sub.level || '特優';
            document.getElementById('gradeFeedback').value = sub.feedback || '';

            document.getElementById('gradeModal').classList.remove('hidden');
        }

        function closeGradeModal() {
            document.getElementById('gradeModal').classList.add('hidden');
        }

        function submitGrade() {
            const sub = submissions.find(s => s.id === currentGradingSubId);
            if (sub) {
                sub.score = parseInt(document.getElementById('gradeScore').value) || 0;
                sub.level = document.getElementById('gradeLevel').value;
                sub.feedback = document.getElementById('gradeFeedback').value.trim();
                sub.status = 'graded';
                saveData();
                renderTeacherSubmissions();
                closeGradeModal();
                alert('批閱完成！評語已公佈予學生。');
            }
        }

        function publishTopic() {
            const title = document.getElementById('newTopicTitle').value.trim();
            const desc = document.getElementById('newTopicDesc').value.trim();
            const dueDate = document.getElementById('newTopicDueDate').value;
            const isWeekly = document.getElementById('newTopicIsWeekly').checked;

            if (!title || !desc || !dueDate) {
                alert('請填寫完整作文題目與截止日期！');
                return;
            }

            if (isWeekly) topics.forEach(t => t.isWeekly = false);

            topics.push({ id: 't_' + Date.now(), title, desc, dueDate, isWeekly });
            saveData();
            renderTopics();
            alert('新作文題目發布成功！');
            switchNav('home');
        }

        function renderArticles(filter = 'all') {
            const grid = document.getElementById('articlesGrid');
            const homeList = document.getElementById('homeArticleList');

            let filtered = articles;
            if (filter === 'bookmarked') filtered = articles.filter(a => a.bookmarked);
            if (filter === 'flagged') filtered = articles.filter(a => a.flagged);

            if (filtered.length === 0) {
                grid.innerHTML = `<p class="col-span-full text-xs text-[#7c634b] py-4 text-center">目前尚無發布的文章。</p>`;
            } else {
                grid.innerHTML = filtered.map(a => `
                    <div class="ancient-card p-4 sm:p-5 rounded-2xl flex flex-col justify-between space-y-4">
                        <div>
                            <div class="flex justify-between items-center mb-2">
                                <span class="text-xs bg-[#e4d7be] text-[#4a2e1b] font-bold px-2.5 py-1 rounded-md border border-[#b8a686]">${a.category}</span>
                                <div class="space-x-2 text-stone-400">
                                    <button onclick="toggleBookmark('${a.id}')" class="${a.bookmarked ? 'text-amber-600' : ''}"><i class="fa-solid fa-star"></i></button>
                                    <button onclick="toggleFlag('${a.id}')" class="${a.flagged ? 'text-red-700' : ''}"><i class="fa-solid fa-flag"></i></button>
                                </div>
                            </div>
                            <h4 class="font-bold text-sm sm:text-base text-[#4a2e1b] mb-2">${a.title}</h4>
                            <p class="text-xs text-[#614935] line-clamp-3 leading-relaxed">${a.content}</p>
                        </div>
                        <div class="pt-2 border-t border-[#d8caa7] flex justify-end">
                            <button onclick="readArticle('${a.id}')" class="text-xs bg-[#e4d7be] text-[#4a2e1b] font-bold px-3 py-1.5 rounded-lg border border-[#b8a686]">閱讀全文</button>
                        </div>
                    </div>
                `).join('');
            }

            if (articles.length === 0) {
                homeList.innerHTML = `<p class="text-xs text-[#7c634b] py-2">目前尚無每週精選文章。</p>`;
            } else {
                homeList.innerHTML = articles.slice(0, 3).map(a => `
                    <div class="p-3 bg-[#f2ebdc] rounded-xl border border-[#b8a686] flex justify-between items-center cursor-pointer" onclick="readArticle('${a.id}')">
                        <div>
                            <p class="font-bold text-[#4a2e1b] text-xs sm:text-sm">${a.title}</p>
                            <p class="text-[10px] sm:text-xs text-[#7c634b]">分類：${a.category}</p>
                        </div>
                        <span class="text-xs text-[#8c2e1b] font-bold">閱讀 →</span>
                    </div>
                `).join('');
            }
        }

        function filterArticles(type) {
            renderArticles(type);
        }

        function toggleBookmark(artId) {
            const art = articles.find(a => a.id === artId);
            if (art) { art.bookmarked = !art.bookmarked; saveData(); renderArticles(); }
        }

        function toggleFlag(artId) {
            const art = articles.find(a => a.id === artId);
            if (art) { art.flagged = !art.flagged; saveData(); renderArticles(); }
        }

        function readArticle(artId) {
            const art = articles.find(a => a.id === artId);
            if (!art) return;

            document.getElementById('readModalCategory').innerText = art.category;
            document.getElementById('readModalTitle').innerText = art.title;
            document.getElementById('readModalContent').innerText = art.content;
            document.getElementById('readModal').classList.remove('hidden');
        }

        function closeReadModal() {
            document.getElementById('readModal').classList.add('hidden');
        }

        function openCreateArticleModal() {
            document.getElementById('articleModal').classList.remove('hidden');
        }

        function closeArticleModal() {
            document.getElementById('articleModal').classList.add('hidden');
        }

        function publishArticle() {
            const title = document.getElementById('newArtTitle').value.trim();
            const category = document.getElementById('newArtCategory').value.trim();
            const content = document.getElementById('newArtContent').value.trim();

            if (!title || !content) { alert('請填寫完整文章內容！'); return; }

            articles.push({ id: 'a_' + Date.now(), title, category: category || '寫作技巧', content, bookmarked: false, flagged: false });
            saveData();
            renderArticles();
            closeArticleModal();
            alert('知識文章發布成功！');
        }

        function renderStudentManagement() {
            const tbody = document.getElementById('studentManagementTable');
            const students = users.filter(u => u.role === 'student');

            if (students.length === 0) {
                tbody.innerHTML = `<tr><td colspan="4" class="p-4 text-center text-[#7c634b] text-xs sm:text-sm">目前尚無已註冊帳號之學生。</td></tr>`;
                return;
            }

            tbody.innerHTML = students.map(s => {
                const mySubs = submissions.filter(sub => sub.studentId === s.id && sub.status === 'graded');
                const avgScore = mySubs.length > 0 
                    ? Math.round(mySubs.reduce((acc, curr) => acc + curr.score, 0) / mySubs.length)
                    : '--';

                return `
                    <tr class="hover:bg-[#f2ebdc]">
                        <td class="p-3 font-bold text-[#4a2e1b]">${s.name}</td>
                        <td class="p-3">${s.email}</td>
                        <td class="p-3 font-bold text-[#8c2e1b]">${submissions.filter(sub => sub.studentId === s.id).length} 篇</td>
                        <td class="p-3 font-bold text-[#2d5a3f]">${avgScore}</td>
                    </tr>
                `;
            }).join('');
        }
    </script>
</body>
</html>