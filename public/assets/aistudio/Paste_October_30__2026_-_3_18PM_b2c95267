<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>寫作與閱讀學習平台</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif+TC:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Noto Serif TC', serif;
            background-color: #f7f4ed;
            background-image: radial-gradient(#e2d9c8 1px, transparent 1px);
            background-size: 24px 24px;
        }
        .active-tab {
            border-bottom: 3px solid #8c2e1b;
            color: #8c2e1b;
            font-weight: 700;
        }
        .ancient-card {
            background-color: #fcfaf5;
            border: 1px solid #d8caa7;
            box-shadow: 2px 3px 10px rgba(80, 60, 40, 0.05);
        }
        .ancient-btn-primary {
            background-color: #8c2e1b;
            color: #fefcf8;
        }
        .ancient-btn-primary:hover {
            background-color: #6f2213;
        }
    </style>
</head>
<body class="min-h-screen text-stone-800 antialiased flex flex-col justify-between">

    <!-- 頂部導覽列 -->
    <header class="bg-[#f2ebdc] border-b-2 border-[#b8a686] sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <div class="flex items-center space-x-3 sm:space-x-4 cursor-pointer" onclick="switchNav('home')">
                <div class="bg-[#8c2e1b] text-[#f2ebdc] p-2 rounded-lg font-bold flex items-center justify-center w-10 h-10 sm:w-12 sm:h-12 shadow flex-shrink-0">
                    <i class="fa-solid fa-scroll text-xl sm:text-2xl"></i>
                </div>
                <div>
                    <h1 class="font-black text-base sm:text-xl tracking-wider text-[#4a2e1b]">寫作與閱讀學習平台</h1>
                    <p class="text-[10px] sm:text-xs text-[#7c634b] font-semibold">線上作文批改 · 每週知識與出題</p>
                </div>
            </div>

            <div class="flex items-center space-x-2 sm:space-x-3">
                <!-- 帳號狀態區 -->
                <div id="authArea" class="flex items-center"></div>
                <!-- 手機版選單開關按鈕 -->
                <button onclick="toggleMobileMenu()" class="lg:hidden p-2 text-[#4a2e1b] hover:text-[#8c2e1b] focus:outline-none">
                    <i class="fa-solid fa-bars text-2xl"></i>
                </button>
            </div>
        </div>

        <!-- 手機版下拉選單 Drawer -->
        <div id="mobileMenu" class="hidden lg:hidden bg-[#f7f4ed] border-b-2 border-[#b8a686] px-4 pt-2 pb-4 space-y-2">
            <button onclick="switchNav('home'); toggleMobileMenu();" class="w-full text-left py-2 px-3 font-bold text-[#4a2e1b] hover:bg-[#e4d7be] rounded-lg flex items-center space-x-2">
                <i class="fa-solid fa-landmark"></i><span>平台公告</span>
            </button>
            <button onclick="switchNav('write'); toggleMobileMenu();" class="w-full text-left py-2 px-3 font-bold text-[#4a2e1b] hover:bg-[#e4d7be] rounded-lg flex items-center space-x-2">
                <i class="fa-solid fa-pen-nib"></i><span>作文寫作區</span>
            </button>
            <button onclick="switchNav('articles'); toggleMobileMenu();" class="w-full text-left py-2 px-3 font-bold text-[#4a2e1b] hover:bg-[#e4d7be] rounded-lg flex items-center space-x-2">
                <i class="fa-solid fa-book-journal-whills"></i><span>知識文章庫</span>
            </button>
            <button onclick="switchNav('records'); toggleMobileMenu();" class="w-full text-left py-2 px-3 font-bold text-[#4a2e1b] hover:bg-[#e4d7be] rounded-lg flex items-center space-x-2 student-only hidden">
                <i class="fa-solid fa-book-bookmark"></i><span>個人作業紀錄</span>
            </button>
            <button onclick="switchNav('teacher'); toggleMobileMenu();" class="w-full text-left py-2 px-3 font-bold text-[#8c2e1b] hover:bg-[#e4d7be] rounded-lg flex items-center space-x-2 teacher-only hidden">
                <i class="fa-solid fa-signature"></i><span>作文批改中心</span>
            </button>
            <button onclick="switchNav('quotes'); toggleMobileMenu();" class="w-full text-left py-2 px-3 font-bold text-[#8c2e1b] hover:bg-[#e4d7be] rounded-lg flex items-center space-x-2 teacher-only hidden">
                <i class="fa-solid fa-quote-left"></i><span>每日名言發布</span>
            </button>
            <button onclick="switchNav('manage-topics'); toggleMobileMenu();" class="w-full text-left py-2 px-3 font-bold text-[#8c2e1b] hover:bg-[#e4d7be] rounded-lg flex items-center space-x-2 teacher-only hidden">
                <i class="fa-solid fa-pen-to-square"></i><span>發布題目</span>
            </button>
            <button onclick="switchNav('students'); toggleMobileMenu();" class="w-full text-left py-2 px-3 font-bold text-[#8c2e1b] hover:bg-[#e4d7be] rounded-lg flex items-center space-x-2 teacher-only hidden">
                <i class="fa-solid fa-users"></i><span>學生名冊</span>
            </button>
        </div>
    </header>

    <!-- 主要內容區 -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 flex-1 w-full">

        <!-- 未登入提示 Banner -->
        <div id="guestBanner" class="ancient-card p-4 sm:p-6 rounded-2xl mb-6 sm:mb-8 border-l-8 border-l-[#8c2e1b] flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
            <div class="flex items-center space-x-3 sm:space-x-4">
                <i class="fa-solid fa-feather-pointed text-2xl sm:text-3xl text-[#8c2e1b] flex-shrink-0"></i>
                <div>
                    <p class="font-bold text-base sm:text-lg text-[#4a2e1b]">歡迎使用學習平台</p>
                    <p class="text-xs sm:text-sm text-[#7c634b]">學生請先登入或註冊；老師請由頁尾專屬通道登入管理後台。</p>
                </div>
            </div>
            <div class="flex space-x-2 sm:space-x-3 w-full sm:w-auto">
                <button onclick="openAuthModal('student-login')" class="flex-1 sm:flex-none ancient-btn-primary text-xs sm:text-sm px-4 sm:px-5 py-2.5 rounded-xl font-bold transition shadow text-center">學生登入</button>
                <button onclick="openAuthModal('student-register')" class="flex-1 sm:flex-none bg-[#e4d7be] hover:bg-[#d8c7a7] text-[#4a2e1b] text-xs sm:text-sm px-4 sm:px-5 py-2.5 rounded-xl font-bold transition border border-[#b8a686] text-center">註冊帳號</button>
            </div>
        </div>

        <!-- 桌機版功能分頁選單 -->
        <div class="hidden lg:flex border-b-2 border-[#d8caa7] mb-8 space-x-8 text-base font-bold overflow-x-auto">
            <button id="nav-home" onclick="switchNav('home')" class="pb-3 px-1 active-tab flex items-center space-x-2 whitespace-nowrap">
                <i class="fa-solid fa-landmark"></i><span>平台公告</span>
            </button>
            <button id="nav-write" onclick="switchNav('write')" class="pb-3 px-1 text-[#7c634b] hover:text-[#4a2e1b] flex items-center space-x-2 whitespace-nowrap">
                <i class="fa-solid fa-pen-nib"></i><span>作文寫作區</span>
            </button>
            <button id="nav-articles" onclick="switchNav('articles')" class="pb-3 px-1 text-[#7c634b] hover:text-[#4a2e1b] flex items-center space-x-2 whitespace-nowrap">
                <i class="fa-solid fa-book-journal-whills"></i><span>知識文章庫</span>
            </button>
            <button id="nav-records" onclick="switchNav('records')" class="pb-3 px-1 text-[#7c634b] hover:text-[#4a2e1b] flex items-center space-x-2 whitespace-nowrap student-only hidden">
                <i class="fa-solid fa-book-bookmark"></i><span>個人作業紀錄</span>
            </button>
            <!-- 老師端功能 -->
            <button id="nav-teacher" onclick="switchNav('teacher')" class="pb-3 px-1 text-[#7c634b] hover:text-[#4a2e1b] flex items-center space-x-2 whitespace-nowrap teacher-only hidden">
                <i class="fa-solid fa-signature"></i><span>作文批改中心</span>
            </button>
            <button id="nav-quotes" onclick="switchNav('quotes')" class="pb-3 px-1 text-[#7c634b] hover:text-[#4a2e1b] flex items-center space-x-2 whitespace-nowrap teacher-only hidden">
                <i class="fa-solid fa-quote-left"></i><span>每日名言發布</span>
            </button>
            <button id="nav-manage-topics" onclick="switchNav('manage-topics')" class="pb-3 px-1 text-[#7c634b] hover:text-[#4a2e1b] flex items-center space-x-2 whitespace-nowrap teacher-only hidden">
                <i class="fa-solid fa-pen-to-square"></i><span>發布題目</span>
            </button>
            <button id="nav-students" onclick="switchNav('students')" class="pb-3 px-1 text-[#7c634b] hover:text-[#4a2e1b] flex items-center space-x-2 whitespace-nowrap teacher-only hidden">
                <i class="fa-solid fa-users"></i><span>學生名冊</span>
            </button>
        </div>

        <!-- 頁面 1: 首頁 -->
        <section id="page-home" class="space-y-6 sm:space-y-8">
            
            <!-- 每日名言佳句專區 -->
            <div class="ancient-card p-5 sm:p-6 rounded-2xl border-2 border-[#b8a686] bg-[#fcf8ef] relative overflow-hidden shadow-sm">
                <div class="absolute -right-4 -bottom-4 text-[#e2d9c8]/40 text-7xl sm:text-8xl pointer-events-none">
                    <i class="fa-solid fa-quote-right"></i>
                </div>
                <div class="relative z-10 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                    <div class="space-y-1.5 flex-1">
                        <div class="flex items-center space-x-2">
                            <span class="bg-[#8c2e1b] text-[#f2ebdc] text-[10px] sm:text-xs px-2.5 py-0.5 rounded-full font-bold">每日名言佳句</span>
                            <span class="text-[10px] sm:text-xs text-[#7c634b] font-semibold"><i class="fa-solid fa-feather mr-1"></i>wen 老師推薦</span>
                        </div>
                        <blockquote id="dailyQuoteText" class="text-base sm:text-lg font-bold text-[#4a2e1b] italic pt-1">
                            今日暫無名言佳句
                        </blockquote>
                    </div>
                </div>
            </div>

            <div class="bg-gradient-to-r from-[#8c2e1b] to-[#5c1c0f] rounded-2xl p-6 sm:p-10 text-[#f7f4ed] shadow-lg border border-[#a8422d]">
                <div class="max-w-3xl space-y-3 sm:space-y-4">
                    <span class="bg-[#f2ebdc]/20 text-[#f2ebdc] text-[10px] sm:text-xs px-2.5 py-1 rounded-full font-bold border border-[#f2ebdc]/30">本週試題</span>
                    <h2 id="homeTopicTitle" class="text-2xl sm:text-3xl font-black tracking-wide">目前尚未發布題目</h2>
                    <p id="homeTopicDesc" class="text-[#e2d9c8] text-xs sm:text-base leading-relaxed">老師尚未發布本週作文題目，請稍後再來查看。</p>
                    <div class="pt-2 flex flex-wrap items-center gap-3 sm:gap-4 text-[10px] sm:text-xs text-[#d8caa7]">
                        <span><i class="fa-regular fa-clock mr-1"></i> 截止日期：<span id="homeTopicDueDate">--</span></span>
                        <span><i class="fa-regular fa-user mr-1"></i> 出題老師：wen 老師</span>
                    </div>
                    <div class="pt-2 sm:pt-4">
                        <button onclick="startWritingCurrentTopic()" class="w-full sm:w-auto justify-center bg-[#f2ebdc] text-[#8c2e1b] hover:bg-white px-6 py-3 rounded-xl font-bold shadow transition flex items-center space-x-2">
                            <i class="fa-solid fa-ink-horn"></i><span>開始寫作</span>
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="ancient-card p-4 sm:p-6 rounded-2xl">
                    <h3 class="font-bold text-base sm:text-lg mb-4 text-[#4a2e1b] flex items-center space-x-2 border-b border-[#d8caa7] pb-2">
                        <i class="fa-solid fa-list-ol text-[#8c2e1b]"></i><span>歷屆題目列表</span>
                    </h3>
                    <div id="homeTopicList" class="space-y-3"></div>
                </div>

                <div class="ancient-card p-4 sm:p-6 rounded-2xl">
                    <h3 class="font-bold text-base sm:text-lg mb-4 text-[#4a2e1b] flex items-center space-x-2 border-b border-[#d8caa7] pb-2">
                        <i class="fa-solid fa-book-open-reader text-[#8c2e1b]"></i><span>每週精選文章</span>
                    </h3>
                    <div id="homeArticleList" class="space-y-3"></div>
                </div>
            </div>
        </section>

        <!-- 頁面 2: 作文寫作區 -->
        <section id="page-write" class="hidden max-w-4xl mx-auto space-y-6">
            <div class="ancient-card p-4 sm:p-8 rounded-2xl space-y-6">
                <div>
                    <label class="block text-xs font-bold text-[#7c634b] uppercase mb-2">選擇要寫作的題目</label>
                    <select id="writeTopicSelect" onchange="onWriteTopicChange()" class="w-full border-2 border-[#b8a686] bg-[#f7f4ed] rounded-xl p-3 text-sm sm:text-base font-bold text-[#4a2e1b] outline-none">
                    </select>
                </div>

                <div class="bg-[#f2ebdc] p-4 rounded-xl border border-[#b8a686]">
                    <p class="font-bold text-[#4a2e1b] text-sm mb-1"><i class="fa-solid fa-compass mr-1"></i>題目引導說明：</p>
                    <p id="writeTopicGuide" class="text-xs sm:text-sm text-[#614935] leading-relaxed">請先由上方選單選擇題目。</p>
                </div>

                <div class="space-y-2">
                    <label class="block text-xs sm:text-sm font-bold text-[#4a2e1b]">作文標題</label>
                    <input type="text" id="essayTitleInput" placeholder="請輸入文章標題..." class="w-full border-2 border-[#b8a686] bg-[#f7f4ed] rounded-xl p-3 text-sm outline-none focus:border-[#8c2e1b]">
                </div>

                <div class="space-y-2">
                    <div class="flex justify-between items-center">
                        <label class="block text-xs sm:text-sm font-bold text-[#4a2e1b]">作文內文</label>
                        <span class="text-xs text-[#7c634b]"><i class="fa-solid fa-calculator mr-1"></i>字數：<span id="charCount" class="font-bold text-[#8c2e1b]">0</span> 字</span>
                    </div>
                    <textarea id="essayContentInput" rows="12" oninput="updateCharCount()" placeholder="由此揮毫鋪陳..." class="w-full border-2 border-[#b8a686] bg-[#f7f4ed] rounded-xl p-3 sm:p-4 outline-none focus:border-[#8c2e1b] leading-relaxed text-sm sm:text-base"></textarea>
                </div>

                <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-4 border-t border-[#d8caa7]">
                    <button onclick="saveDraft()" class="w-full sm:w-auto bg-[#e4d7be] hover:bg-[#d8c7a7] text-[#4a2e1b] px-5 py-2.5 rounded-xl text-sm font-bold transition">儲存草稿</button>
                    <button onclick="submitEssay()" class="w-full sm:w-auto ancient-btn-primary px-6 py-2.5 rounded-xl text-sm font-bold shadow transition">正式呈交作業</button>
                </div>
            </div>
        </section>

        <!-- 頁面 3: 知識文章庫 -->
        <section id="page-articles" class="hidden space-y-6">
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 ancient-card p-4 rounded-xl">
                <div class="flex items-center space-x-2 overflow-x-auto w-full sm:w-auto pb-1 sm:pb-0">
                    <button onclick="filterArticles('all')" class="art-filter px-3 sm:px-4 py-1.5 sm:py-2 text-xs font-bold rounded-lg bg-[#8c2e1b] text-white whitespace-nowrap">全部文章</button>
                    <button onclick="filterArticles('bookmarked')" class="art-filter px-3 sm:px-4 py-1.5 sm:py-2 text-xs font-bold rounded-lg bg-[#e4d7be] text-[#4a2e1b] whitespace-nowrap">⭐ 收藏清單</button>
                    <button onclick="filterArticles('flagged')" class="art-filter px-3 sm:px-4 py-1.5 sm:py-2 text-xs font-bold rounded-lg bg-[#e4d7be] text-[#4a2e1b] whitespace-nowrap">🚩 重要標記</button>
                </div>
                <button onclick="openCreateArticleModal()" class="teacher-only hidden w-full sm:w-auto justify-center bg-[#2d5a3f] hover:bg-[#20432f] text-white px-4 py-2 rounded-lg text-xs sm:text-sm font-bold transition flex items-center space-x-2">
                    <i class="fa-solid fa-pen-nib"></i><span>發布知識文章</span>
                </button>
            </div>

            <div id="articlesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
        </section>

        <!-- 頁面 4: 學生個人作業紀錄 -->
        <section id="page-records" class="hidden space-y-6">
            <div class="ancient-card p-4 sm:p-6 rounded-2xl">
                <h3 class="font-bold text-base sm:text-lg mb-4 text-[#4a2e1b] flex items-center space-x-2 border-b border-[#d8caa7] pb-3">
                    <i class="fa-solid fa-clock-rotate-left text-[#8c2e1b]"></i><span>個人作業呈交與批閱記錄</span>
                </h3>
                <div id="studentRecordList" class="space-y-4"></div>
            </div>
        </section>

        <!-- 頁面 5: 老師批改中心 -->
        <section id="page-teacher" class="hidden space-y-6">
            <div class="ancient-card p-4 sm:p-6 rounded-2xl">
                <h3 class="font-bold text-base sm:text-lg mb-4 sm:mb-6 text-[#4a2e1b] flex items-center space-x-2 border-b border-[#d8caa7] pb-3">
                    <i class="fa-solid fa-list-check text-[#8c2e1b]"></i><span>學生作文呈交清單</span>
                </h3>
                <div class="overflow-x-auto -mx-4 sm:mx-0 px-4 sm:px-0">
                    <table class="w-full text-left text-xs sm:text-sm text-[#4a2e1b] min-w-[600px]">
                        <thead class="bg-[#f2ebdc] text-[#7c634b] uppercase text-[10px] sm:text-xs">
                            <tr>
                                <th class="p-3">學生姓名</th>
                                <th class="p-3">題目</th>
                                <th class="p-3">呈交日期</th>
                                <th class="p-3">狀態</th>
                                <th class="p-3">得分 / 等級</th>
                                <th class="p-3 text-right">批閱操作</th>
                            </tr>
                        </thead>
                        <tbody id="teacherSubmissionTable" class="divide-y divide-[#d8caa7]"></tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- 頁面 6: 老師每日名言管理 -->
        <section id="page-quotes" class="hidden max-w-3xl mx-auto space-y-6">
            <div class="ancient-card p-4 sm:p-8 rounded-2xl space-y-6">
                <h3 class="font-bold text-base sm:text-lg text-[#4a2e1b] border-b border-[#d8caa7] pb-3 flex items-center space-x-2">
                    <i class="fa-solid fa-quote-left text-[#8c2e1b]"></i><span>發布首頁「每日名言佳句」</span>
                </h3>
                
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs sm:text-sm font-bold text-[#7c634b] mb-1">今日名言佳句內容</label>
                        <textarea id="teacherDailyQuoteInput" rows="4" placeholder="例如：長風破浪會有時，直掛雲帆濟滄海。—— 李白" class="w-full border-2 border-[#b8a686] bg-[#f7f4ed] rounded-xl p-3 text-xs sm:text-sm outline-none focus:border-[#8c2e1b]"></textarea>
                    </div>
                    <div class="flex justify-end">
                        <button onclick="updateDailyQuote()" class="w-full sm:w-auto ancient-btn-primary px-6 py-2.5 rounded-xl text-xs sm:text-sm font-bold transition shadow">
                            更新首頁名言佳句
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- 頁面 7: 老師發布題目 -->
        <section id="page-manage-topics" class="hidden max-w-2xl mx-auto space-y-6">
            <div class="ancient-card p-4 sm:p-8 rounded-2xl space-y-6">
                <h3 class="font-bold text-base sm:text-lg text-[#4a2e1b] border-b border-[#d8caa7] pb-3">發布每週作文題目</h3>
                <div class="space-y-4 text-xs sm:text-sm">
                    <div>
                        <label class="block font-bold mb-1">作文題目</label>
                        <input type="text" id="newTopicTitle" placeholder="例如：記一次難忘的遊歷" class="w-full border-2 border-[#b8a686] bg-[#f7f4ed] rounded-xl p-3 outline-none">
                    </div>
                    <div>
                        <label class="block font-bold mb-1">題目引導說明</label>
                        <textarea id="newTopicDesc" rows="4" placeholder="請輸入對學生作文的引導要求與思考方向..." class="w-full border-2 border-[#b8a686] bg-[#f7f4ed] rounded-xl p-3 outline-none"></textarea>
                    </div>
                    <div>
                        <label class="block font-bold mb-1">截止日期</label>
                        <input type="date" id="newTopicDueDate" class="w-full border-2 border-[#b8a686] bg-[#f7f4ed] rounded-xl p-3 outline-none">
                    </div>
                    <div class="flex items-center space-x-2">
                        <input type="checkbox" id="newTopicIsWeekly" class="w-4 h-4 text-[#8c2e1b] rounded">
                        <label for="newTopicIsWeekly" class="font-bold text-[#4a2e1b]">設為本週首頁主打題目</label>
                    </div>
                </div>
